# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.tmp*
# testing
/coverage
/cypress/videos
/cypress/screenshots
/cypress/downloads
.cypress-cache/

# next.js
/.next/
/out/

# Generated per-locale comparison payloads (built by emit:comparison)
/public/data/comparison/

# Assembled monolith for Python verify scripts (pnpm assemble:comparison)
/data/comparison.json

# Citation verify caches
/.tmp-verify/

# Python
**/__pycache__/
*.py[cod]

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
