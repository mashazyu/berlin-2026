  "packageManager": "pnpm@9",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern next-env.d.ts",
    "type-check": "tsc --noEmit --incremental false",
    "prebuild": "node scripts/emit-comparison-public.mjs",
    "predev": "node scripts/emit-comparison-public.mjs",
    "split:comparison": "node scripts/split-comparison.mjs",
    "assemble:comparison": "node scripts/assemble-comparison.mjs",
    "emit:comparison": "node scripts/emit-comparison-public.mjs",
    "encode:comparison": "node scripts/encode-comparison.mjs && node scripts/split-comparison.mjs",
    "regen:og-fonts": "node scripts/regen-og-fonts.mjs",
    "verify:citations": "node scripts/assemble-comparison.mjs && python3 scripts/verify-citations.py --force-extract",
    "verify:relevance": "node scripts/assemble-comparison.mjs && python3 scripts/verify-relevance.py",
    "indexnow:submit": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@radix-ui/react-scroll-area": "^1.2.18",
